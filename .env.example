# ==============================================================================
# ResearchMind - Environment Configuration Template
# Copy this file to .env and populate with local development values.
# NEVER commit .env or real credentials/secrets to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
APP_NAME=ResearchMind
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8080

# Gemini & AI Models
# Provide your Google AI Studio or Vertex AI Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192

# Google Cloud Platform Configuration
GCP_PROJECT_ID=researchmind-dev
GCP_REGION=us-central1
# Path to local service account key file (leave empty if using ADC or local mock)
GOOGLE_APPLICATION_CREDENTIALS=

# Pub/Sub Orchestration
PUBSUB_TASKS_TOPIC=researchmind-agent-tasks
PUBSUB_TASKS_SUBSCRIPTION=researchmind-agent-tasks-sub
PUBSUB_EVENTS_TOPIC=researchmind-workflow-events

# Firestore Persistence
FIRESTORE_DATABASE=(default)
FIRESTORE_RUNS_COLLECTION=research_runs
FIRESTORE_TASKS_COLLECTION=research_tasks

# Google Cloud Storage (GCS)
GCS_BUCKET_ARTIFACTS=researchmind-artifacts-dev
GCS_BUCKET_UPLOADS=researchmind-uploads-dev

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=research_evidence
QDRANT_VECTOR_SIZE=768

# Logging & Tracing
LOG_LEVEL=INFO
LOG_FORMAT=json
