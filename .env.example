# ==============================================================================
# ResearchMind - Environment Configuration Template
# Copy this file to .env and populate with local development values.
# NEVER commit .env or real credentials/secrets to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
APP_NAME=ResearchMind
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8080

# Gemini & AI Models
LLM_PROVIDER=in_memory
EMBEDDING_PROVIDER=in_memory
# Provide your Google AI Studio or Vertex AI Gemini API key (for live gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_REQUEST_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_RETRY_DELAY_SECONDS=1.0
GEMINI_MAX_RETRY_DELAY_SECONDS=10.0

# Search & Evidence Gathering
SEARCH_PROVIDER=in_memory
ACADEMIC_SEARCH_PROVIDER=in_memory
# Tavily Search API configuration
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_REQUEST_TIMEOUT_SECONDS=15.0
TAVILY_MAX_RETRIES=3
# arXiv API configuration (public endpoint)
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_REQUEST_TIMEOUT_SECONDS=20.0
ARXIV_MAX_RETRIES=3

# Qdrant Vector Database
VECTOR_STORE_PROVIDER=in_memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=research_evidence
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE=Cosine
QDRANT_REQUEST_TIMEOUT_SECONDS=30.0
QDRANT_MAX_RETRIES=3

# Google Cloud Platform Configuration
GCP_PROJECT_ID=researchmind-dev
GCP_REGION=us-central1
# Path to local service account key file (leave empty if using ADC or local mock)
GOOGLE_APPLICATION_CREDENTIALS=

# Pub/Sub Orchestration
JOB_TRANSPORT=in_memory
PUBSUB_TASKS_TOPIC=researchmind-agent-tasks
PUBSUB_TASKS_SUBSCRIPTION=researchmind-agent-tasks-sub
PUBSUB_EVENTS_TOPIC=researchmind-workflow-events
PUBSUB_DEAD_LETTER_TOPIC=researchmind-agent-tasks-dlq

# Firestore Persistence
PERSISTENCE_BACKEND=in_memory
FIRESTORE_DATABASE=(default)
FIRESTORE_RUNS_COLLECTION=research_runs
FIRESTORE_TASKS_COLLECTION=research_tasks

# Google Cloud Storage (GCS)
GCS_BUCKET_ARTIFACTS=researchmind-artifacts-dev
GCS_BUCKET_UPLOADS=researchmind-uploads-dev

# Logging & Tracing
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================================================
# Phase 6.5 — API Security, Authentication & Request Protection
# ==============================================================================

# API-Key Authentication
# Set to true to enable Bearer-token API key authentication for all /api/v1/* endpoints.
# /healthz remains publicly accessible regardless of this setting.
# When false (default), the API is unauthenticated — suitable for local development only.
API_AUTH_ENABLED=false
# The shared API key clients must supply in the Authorization: Bearer header.
# Generate a strong random key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER set a real key here. Copy .env.example to .env and populate there.
API_KEY=your_strong_api_key_here

# CORS — Allowed Origins
# Comma-separated list of explicit allowed origins. Do NOT use wildcard '*' in production.
# Wildcard is disallowed when credentials are enabled and will be filtered with a warning.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Rate Limiting (process-local, not distributed)
# WARNING: RATE_LIMIT_ENABLED=true enables an IN-MEMORY, PROCESS-LOCAL sliding-window
# rate limiter. This limiter is NOT shared across multiple instances or worker processes.
# For horizontally scaled deployments, replace InMemoryRateLimiter with a Redis-backed
# implementation that satisfies the RateLimiterProtocol interface.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Request Size Limits
# Maximum character length for research goal queries (applies to /api/v1/runs query field).
MAX_RESEARCH_GOAL_LENGTH=4000
# Maximum allowed request body size in bytes (1 MiB default).
# Requests with a Content-Length header exceeding this are rejected with HTTP 413.
MAX_REQUEST_BODY_BYTES=1048576

# ==============================================================================
# Phase 6.6 — Durable Artifact Storage (Google Cloud Storage / In-Memory)
# ==============================================================================

# Storage provider: 'in_memory' for local offline testing (default), 'gcs' for production
ARTIFACT_STORAGE_PROVIDER=in_memory

# Google Cloud Storage bucket for persistent research artifacts (reports, dossiers, snapshots)
GCS_BUCKET=researchmind-artifacts-dev

# Optional GCP project override (defaults to GCP_PROJECT_ID if omitted)
GCS_PROJECT=

# Object key prefix inside GCS bucket
GCS_PREFIX=artifacts

# Expiration duration in seconds for generated signed download URLs (default: 3600 = 1 hour)
GCS_SIGNED_URL_EXPIRATION_SECONDS=3600


